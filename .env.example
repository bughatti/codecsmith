# Optional environment overrides. Everything here can also live in config.yaml;
# the environment wins when both are set.

# Required only for Postgres installs:
# CODECSMITH_DB_DSN=postgres://codecsmith:password@db:5432/codecsmith?sslmode=disable

# Protect the dashboard's write actions and webhooks:
# CODECSMITH_API_KEY=change-me
# CODECSMITH_WEBHOOK_SECRET=

# SABnzbd download panel:
# SABNZBD_ENABLED=true
# SABNZBD_URL=http://sabnzbd:8080
# SABNZBD_API_KEY=

# Container identity (linuxserver.io convention):
# PUID=1000
# PGID=1000
# PGIDS=44,109
